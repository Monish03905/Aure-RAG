# Required for voice STT (Sarvam Saaras v3)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: comma-separated origins, or * for local demo
CORS_ORIGINS=*

# Optional offline generation via a local Ollama server.
# Leave the model blank to use fast, extractive grounded answers.
# Install Ollama and pull a model first, for example: ollama pull qwen2.5:3b
AURA_LOCAL_LLM_URL=http://127.0.0.1:11434
AURA_LOCAL_LLM_MODEL=
AURA_LOCAL_LLM_TIMEOUT_SECONDS=90
